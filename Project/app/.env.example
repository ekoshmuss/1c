# Скопируйте этот файл в .env и заполните. Файл .env не отправляется на GitHub.

# Порт веб-интерфейса (откройте его в брандмауэре для сети учреждения)
PORT=8080

# Адрес HTTP-сервиса 1С (без /stock на конце)
# Копия базы:   http://192.168.2.3:6536/vigruzki/hs/labstock
# Рабочая база: http://192.168.2.3:6536/new/hs/labstock   (после переноса расширения)
ONEC_URL=http://192.168.2.3:6536/vigruzki/hs/labstock

# Пользователь 1С только для чтения (не Админ)
ONEC_USER=web_api
ONEC_PASS=

# Склад, который открывается по умолчанию (часть названия)
# Склады в интерфейсе (начало наименования через запятую)
WAREHOUSES=018,023
DEFAULT_WAREHOUSE=018

# Пороги индикатора, % от нормы запаса
RED_PCT=20
YELLOW_PCT=50

# За сколько дней до истечения срока годности подсвечивать
EXPIRY_WARN_DAYS=60

# Сколько секунд держать данные 1С в памяти (защита от частых запросов)
CACHE_SECONDS=15

# --- Доступ по домену (через IIS как обратный прокси) ---
# 127.0.0.1 — сайт доступен только через IIS/домен; 0.0.0.0 — ещё и напрямую по http://IP:PORT
HOST=0.0.0.0
# 1 — сайт открывается через IIS/nginx (нужно для правильного IP в журнале и HTTPS-cookie)
TRUST_PROXY=0
# 1 — только при работе через HTTPS
COOKIE_SECURE=0

// =====================================================================
// Модуль HTTP-сервиса "лаб_Склад" (расширение LabStock)
// Корневой URL: labstock
// Шаблоны:  /ping      -> лаб_PingGET
//           /meta      -> лаб_MetaGET
//           /stock     -> лаб_StockGET      ?date=2026-11-09&wh=018,023
//           /receipts  -> лаб_ReceiptsGET   ?date=2026-11-09&wh=018,023  (последнее поступление)
//           /usage     -> лаб_UsageGET      ?date=2026-11-09&wh=018,023&days=30  (расход за период)
// Параметр wh — начало наименования склада (через запятую). Без wh — все склады.
// =====================================================================

#Область Настройки

// Регистр накопления раздела "Учет медикаментов"
// Измерения: Организация, ИсточникФинансирования, КлассификацияРасходов, Медикамент,
//            СерияМедикаментов, СчетУчета, Склад, СтруктурноеПодразделение
// Ресурсы:   Количество, Сумма
Функция ИмяРегистра()
	Возврат "УчетМедикаментов";
КонецФункции

#КонецОбласти

#Область Обработчики

Функция лаб_PingGET(Запрос)
	Возврат ОтветJSON(200, Новый Структура("status, time", "ok", ТекущаяДатаСеанса()));
КонецФункции

Функция лаб_MetaGET(Запрос)
	Попытка
		Инфо = Новый СистемнаяИнформация;
		МетаРег = Метаданные.РегистрыНакопления.Найти(ИмяРегистра());
		Результат = Новый Структура;
		Результат.Вставить("configuration", Метаданные.Синоним);
		Результат.Вставить("version", Метаданные.Версия);
		Результат.Вставить("platform", Инфо.ВерсияПриложения);
		Результат.Вставить("register", ИмяРегистра());
		Результат.Вставить("dimensions", ИменаОбъектов(МетаРег.Измерения));
		Результат.Вставить("resources", ИменаОбъектов(МетаРег.Ресурсы));
		Склады = Новый Массив;
		Для Каждого Склад Из СкладыПоКодам("") Цикл
			Склады.Добавить(СокрЛП(Строка(Склад)));
		КонецЦикла;
		Результат.Вставить("warehouses", Склады);
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Остатки по складу, медикаменту и серии.
Функция лаб_StockGET(Запрос)
	Попытка
		ДатаОстатков = ДатаИзЗапроса(Запрос);
		Склады = СкладыПоКодам(Запрос.ПараметрыЗапроса.Получить("wh"));

		Поля = Новый Массив;
		Группировки = Новый Массив;
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Склад) КАК Склад");
		Поля.Добавить("О.Медикамент.Код КАК Код");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Медикамент) КАК Наименование");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Медикамент.Родитель) КАК Группа");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.СерияМедикаментов) КАК Серия");
		Группировки.Добавить("О.Склад");
		Группировки.Добавить("О.Медикамент");
		Группировки.Добавить("О.Медикамент.Код");
		Группировки.Добавить("О.Медикамент.Родитель");
		Группировки.Добавить("О.СерияМедикаментов");

		ИмяЕд = ИмяРеквизитаЕдиницы();
		Если ЗначениеЗаполнено(ИмяЕд) Тогда
			Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Медикамент." + ИмяЕд + ") КАК ЕдиницаИзмерения");
			Группировки.Добавить("О.Медикамент." + ИмяЕд);
		КонецЕсли;

		МетаСерии = Метаданные.Справочники.Найти("СерииМедикаментов");
		Если МетаСерии <> Неопределено И МетаСерии.Реквизиты.Найти("СрокГодности") <> Неопределено Тогда
			Поля.Добавить("О.СерияМедикаментов.СрокГодности КАК СрокГодности");
			Группировки.Добавить("О.СерияМедикаментов.СрокГодности");
		КонецЕсли;

		Поля.Добавить("СУММА(О.КоличествоОстаток) КАК Количество");
		Поля.Добавить("СУММА(О.СуммаОстаток) КАК Сумма");

		Условие = "";
		Если Склады <> Неопределено Тогда
			Условие = "Склад В (&Склады)";
		КонецЕсли;

		ТекстЗапроса = "ВЫБРАТЬ " + СтрСоединить(Поля, "," + Символы.ПС)
			+ " ИЗ РегистрНакопления." + ИмяРегистра() + ".Остатки(&Граница, " + Условие + ") КАК О"
			+ " СГРУППИРОВАТЬ ПО " + СтрСоединить(Группировки, ", ")
			+ " ИМЕЮЩИЕ СУММА(О.КоличествоОстаток) <> 0";

		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.УстановитьПараметр("Граница", Новый Граница(КонецДня(ДатаОстатков), ВидГраницы.Включая));
		Запрос1С.УстановитьПараметр("Склады", Склады);
		Таблица = Запрос1С.Выполнить().Выгрузить();
		Таблица.Сортировать("Склад, Наименование");

		Результат = Новый Структура;
		Результат.Вставить("register", ИмяРегистра());
		Результат.Вставить("date", ДатаОстатков);
		Результат.Вставить("count", Таблица.Количество());
		Результат.Вставить("items", ТаблицаВМассив(Таблица));
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Последнее поступление (любой приход) по складу и медикаменту.
Функция лаб_ReceiptsGET(Запрос)
	Попытка
		ДатаОстатков = ДатаИзЗапроса(Запрос);
		Склады = СкладыПоКодам(Запрос.ПараметрыЗапроса.Получить("wh"));

		УсловиеСклад = "";
		Если Склады <> Неопределено Тогда
			УсловиеСклад = " И Д.Склад В (&Склады)";
		КонецЕсли;

		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Д.Склад КАК Склад,
		|	Д.Медикамент КАК Медикамент,
		|	Д.Регистратор КАК Регистратор,
		|	МАКСИМУМ(Д.Период) КАК Период,
		|	СУММА(Д.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТПриходы
		|ИЗ
		|	РегистрНакопления." + ИмяРегистра() + " КАК Д
		|ГДЕ
		|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И Д.Активность
		|	И Д.Период <= &Дата" + УсловиеСклад + "
		|СГРУППИРОВАТЬ ПО
		|	Д.Склад, Д.Медикамент, Д.Регистратор
		|ИМЕЮЩИЕ
		|	СУММА(Д.Количество) > 0
		|;
		|ВЫБРАТЬ
		|	П.Склад КАК Склад,
		|	П.Медикамент КАК Медикамент,
		|	МАКСИМУМ(П.Период) КАК Период
		|ПОМЕСТИТЬ ВТПоследние
		|ИЗ
		|	ВТПриходы КАК П
		|СГРУППИРОВАТЬ ПО
		|	П.Склад, П.Медикамент
		|;
		|ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(П.Склад) КАК Склад,
		|	П.Медикамент.Код КАК Код,
		|	П.Период КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(П.Регистратор) КАК Документ,
		|	СУММА(П.Количество) КАК Количество
		|ИЗ
		|	ВТПриходы КАК П
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследние КАК Л
		|		ПО П.Склад = Л.Склад
		|			И П.Медикамент = Л.Медикамент
		|			И П.Период = Л.Период
		|СГРУППИРОВАТЬ ПО
		|	П.Склад, П.Медикамент, П.Медикамент.Код, П.Период, П.Регистратор";

		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.УстановитьПараметр("Дата", КонецДня(ДатаОстатков));
		Запрос1С.УстановитьПараметр("Склады", Склады);
		Таблица = Запрос1С.Выполнить().Выгрузить();

		Результат = Новый Структура;
		Результат.Вставить("date", ДатаОстатков);
		Результат.Вставить("count", Таблица.Количество());
		Результат.Вставить("items", ТаблицаВМассив(Таблица));
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Расход (любое выбытие) по складу и медикаменту за последние N дней.
Функция лаб_UsageGET(Запрос)
	Попытка
		ДатаКонца = ДатаИзЗапроса(Запрос);
		Склады = СкладыПоКодам(Запрос.ПараметрыЗапроса.Получить("wh"));
		Дней = 30;
		ПараметрДней = Запрос.ПараметрыЗапроса.Получить("days");
		Если ЗначениеЗаполнено(ПараметрДней) Тогда
			Дней = Макс(1, Мин(365, Число(ПараметрДней)));
		КонецЕсли;

		УсловиеСклад = "";
		Если Склады <> Неопределено Тогда
			УсловиеСклад = " И Д.Склад В (&Склады)";
		КонецЕсли;

		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(Д.Склад) КАК Склад,
		|	Д.Медикамент.Код КАК Код,
		|	СУММА(Д.Количество) КАК Количество
		|ИЗ
		|	РегистрНакопления." + ИмяРегистра() + " КАК Д
		|ГДЕ
		|	Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И Д.Активность
		|	И Д.Период МЕЖДУ &Начало И &Конец" + УсловиеСклад + "
		|СГРУППИРОВАТЬ ПО
		|	Д.Склад, Д.Медикамент, Д.Медикамент.Код";

		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.УстановитьПараметр("Начало", НачалоДня(ДатаКонца) - (Дней - 1) * 86400);
		Запрос1С.УстановитьПараметр("Конец", КонецДня(ДатаКонца));
		Запрос1С.УстановитьПараметр("Склады", Склады);
		Таблица = Запрос1С.Выполнить().Выгрузить();

		Результат = Новый Структура;
		Результат.Вставить("date", ДатаКонца);
		Результат.Вставить("days", Дней);
		Результат.Вставить("count", Таблица.Количество());
		Результат.Вставить("items", ТаблицаВМассив(Таблица));
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Служебные

Функция ДатаИзЗапроса(Запрос)
	ПараметрДата = Запрос.ПараметрыЗапроса.Получить("date");
	Если ЗначениеЗаполнено(ПараметрДата) Тогда
		Возврат Дата(СтрЗаменить(ПараметрДата, "-", ""));
	КонецЕсли;
	Возврат ТекущаяДатаСеанса();
КонецФункции

// Массив ссылок на склады, наименование которых начинается с одного из кодов ("018,023").
// Коды не переданы: Неопределено (без отбора). Пустая строка "": все склады (для /meta).
Функция СкладыПоКодам(Коды)
	Если Коды = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаИзмерение = Метаданные.РегистрыНакопления.Найти(ИмяРегистра()).Измерения.Найти("Склад");
	МетаСклад = Метаданные.НайтиПоТипу(МетаИзмерение.Тип.Типы()[0]);
	Запрос1С = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ " + МетаСклад.ПолноеИмя() + " ГДЕ НЕ ПометкаУдаления");
	Все = Запрос1С.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Коды = "" Тогда
		Возврат Все;
	КонецЕсли;
	Результат = Новый Массив;
	СписокКодов = СтрРазделить(Коды, ",", Ложь);
	Для Каждого Склад Из Все Цикл
		Имя = СокрЛП(Строка(Склад));
		Для Каждого Код Из СписокКодов Цикл
			Если СтрНачинаетсяС(Имя, СокрЛП(Код)) Тогда
				Результат.Добавить(Склад);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИмяРеквизитаЕдиницы()
	МетаИзмерение = Метаданные.РегистрыНакопления.Найти(ИмяРегистра()).Измерения.Найти("Медикамент");
	МетаНоменклатура = Метаданные.НайтиПоТипу(МетаИзмерение.Тип.Типы()[0]);
	Если МетаНоменклатура = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ИмяЕд Из СтрРазделить("БазоваяЕдиницаИзмерения,ЕдиницаИзмерения,ЕдиницаХраненияОстатков", ",") Цикл
		Если МетаНоменклатура.Реквизиты.Найти(ИмяЕд) <> Неопределено Тогда
			Возврат ИмяЕд;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ТаблицаВМассив(Таблица)
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Элемент = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Элемент.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Строки.Добавить(Элемент);
	КонецЦикла;
	Возврат Строки;
КонецФункции

Функция ОтветJSON(КодСостояния, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ИменаОбъектов(Коллекция)
	Массив = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Массив.Добавить(Элемент.Имя + " (" + Элемент.Синоним + ")");
	КонецЦикла;
	Возврат Массив;
КонецФункции

#КонецОбласти

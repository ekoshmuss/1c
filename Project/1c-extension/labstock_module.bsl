// =====================================================================
// Модуль HTTP-сервиса "лаб_Склад" (расширение LabStock)
// Корневой URL: labstock
// Шаблоны:  /ping  -> лаб_PingGET
//           /meta  -> лаб_MetaGET
//           /stock -> лаб_StockGET   (параметры: ?date=2026-11-09&account=13)
// =====================================================================

#Область Настройки

// Имя регистра бухгалтерии с остатками запасов.
// Пусто = берётся первый регистр бухгалтерии конфигурации.
// Уточняется по результату /meta.
Функция ИмяРегистра()
	Возврат "";
КонецФункции

// Начало кода счетов запасов по умолчанию (можно передать ?account=...)
Функция МаскаСчетовПоУмолчанию()
	Возврат "13";
КонецФункции

#КонецОбласти

#Область Обработчики

Функция лаб_PingGET(Запрос)
	Возврат ОтветJSON(200, Новый Структура("status, time", "ok", ТекущаяДатаСеанса()));
КонецФункции

// Описание структуры конфигурации: нужно, чтобы точно настроить запрос остатков.
Функция лаб_MetaGET(Запрос)
	Попытка
		Инфо = Новый СистемнаяИнформация;
		Результат = Новый Структура;
		Результат.Вставить("configuration", Метаданные.Синоним);
		Результат.Вставить("configName", Метаданные.Имя);
		Результат.Вставить("version", Метаданные.Версия);
		Результат.Вставить("platform", Инфо.ВерсияПриложения);

		РегистрыБух = Новый Массив;
		Для Каждого Р Из Метаданные.РегистрыБухгалтерии Цикл
			Описание = Новый Структура;
			Описание.Вставить("name", Р.Имя);
			Описание.Вставить("synonym", Р.Синоним);
			Описание.Вставить("chartOfAccounts", Р.ПланСчетов.Имя);
			Описание.Вставить("maxSubconto", Р.ПланСчетов.МаксКоличествоСубконто);
			Описание.Вставить("dimensions", ИменаОбъектов(Р.Измерения));
			Описание.Вставить("resources", ИменаОбъектов(Р.Ресурсы));
			Описание.Вставить("accounts", СчетаЗапасов(Р.ПланСчетов.Имя, МаскаСчетовПоУмолчанию()));
			РегистрыБух.Добавить(Описание);
		КонецЦикла;
		Результат.Вставить("accountingRegisters", РегистрыБух);

		РегистрыНакоп = Новый Массив;
		Для Каждого Р Из Метаданные.РегистрыНакопления Цикл
			Описание = Новый Структура;
			Описание.Вставить("name", Р.Имя);
			Описание.Вставить("synonym", Р.Синоним);
			Описание.Вставить("kind", Строка(Р.ВидРегистра));
			Описание.Вставить("dimensions", ИменаОбъектов(Р.Измерения));
			Описание.Вставить("resources", ИменаОбъектов(Р.Ресурсы));
			РегистрыНакоп.Добавить(Описание);
		КонецЦикла;
		Результат.Вставить("accumulationRegisters", РегистрыНакоп);

		Справочники = Новый Массив;
		Ключи = СтрРазделить("номенкл,материал,склад,запас,мол,подраздел,лекарств,медикам", ",");
		Для Каждого С Из Метаданные.Справочники Цикл
			Текст = НРег(С.Имя + " " + С.Синоним);
			Для Каждого К Из Ключи Цикл
				Если СтрНайти(Текст, К) > 0 Тогда
					Справочники.Добавить(Новый Структура("name, synonym", С.Имя, С.Синоним));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Результат.Вставить("catalogs", Справочники);

		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Остатки по счетам запасов на дату.
Функция лаб_StockGET(Запрос)
	Попытка
		ДатаОстатков = ТекущаяДатаСеанса();
		ПараметрДата = Запрос.ПараметрыЗапроса.Получить("date");
		Если ЗначениеЗаполнено(ПараметрДата) Тогда
			ДатаОстатков = Дата(СтрЗаменить(ПараметрДата, "-", ""));
		КонецЕсли;

		Маска = Запрос.ПараметрыЗапроса.Получить("account");
		Если Не ЗначениеЗаполнено(Маска) Тогда
			Маска = МаскаСчетовПоУмолчанию();
		КонецЕсли;

		Имя = ИмяРегистра();
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Имя = Метаданные.РегистрыБухгалтерии[0].Имя;
		КонецЕсли;
		МетаРегистр = Метаданные.РегистрыБухгалтерии.Найти(Имя);

		Поля = Новый Массив;
		Поля.Добавить("Остатки.Счет.Код КАК Счет");
		Поля.Добавить("Остатки.Счет.Наименование КАК СчетНаименование");
		Для Каждого Изм Из МетаРегистр.Измерения Цикл
			Поля.Добавить(СтрШаблон("ПРЕДСТАВЛЕНИЕ(Остатки.%1) КАК %1", Изм.Имя));
		КонецЦикла;
		Для Н = 1 По Мин(МетаРегистр.ПланСчетов.МаксКоличествоСубконто, 3) Цикл
			Поля.Добавить(СтрШаблон("ПРЕДСТАВЛЕНИЕ(Остатки.Субконто%1) КАК Субконто%1", Н));
		КонецЦикла;

		Условия = Новый Массив;
		Для Каждого Рес Из МетаРегистр.Ресурсы Цикл
			Поля.Добавить(СтрШаблон("Остатки.%1ОстатокДт КАК %1", Рес.Имя));
			Условия.Добавить(СтрШаблон("Остатки.%1ОстатокДт <> 0", Рес.Имя));
		КонецЦикла;

		ТекстЗапроса = "ВЫБРАТЬ " + СтрСоединить(Поля, "," + Символы.ПС)
			+ " ИЗ РегистрБухгалтерии." + Имя + ".Остатки(&Граница, Счет.Код ПОДОБНО &Маска, , ) КАК Остатки";
		Если Условия.Количество() > 0 Тогда
			ТекстЗапроса = ТекстЗапроса + " ГДЕ " + СтрСоединить(Условия, " ИЛИ ");
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Счет";

		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.УстановитьПараметр("Граница", Новый Граница(КонецДня(ДатаОстатков), ВидГраницы.Включая));
		Запрос1С.УстановитьПараметр("Маска", Маска + "%");
		Таблица = Запрос1С.Выполнить().Выгрузить();

		Строки = Новый Массив;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Элемент = Новый Структура;
			Для Каждого Колонка Из Таблица.Колонки Цикл
				Элемент.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
			КонецЦикла;
			Строки.Добавить(Элемент);
		КонецЦикла;

		Результат = Новый Структура;
		Результат.Вставить("register", Имя);
		Результат.Вставить("date", ДатаОстатков);
		Результат.Вставить("accountMask", Маска);
		Результат.Вставить("count", Строки.Количество());
		Результат.Вставить("items", Строки);
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Служебные

Функция ОтветJSON(КодСостояния, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ИменаОбъектов(Коллекция)
	Массив = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Массив.Добавить(Элемент.Имя + " (" + Элемент.Синоним + ")");
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция СчетаЗапасов(ИмяПланаСчетов, Маска)
	Массив = Новый Массив;
	Запрос1С = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование ИЗ ПланСчетов." + ИмяПланаСчетов
		+ " ГДЕ Код ПОДОБНО &Маска УПОРЯДОЧИТЬ ПО Код");
	Запрос1С.УстановитьПараметр("Маска", Маска + "%");
	Выборка = Запрос1С.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Субконто = Новый Массив;
		Для Каждого СтрокаСубконто Из Выборка.Ссылка.ВидыСубконто Цикл
			Субконто.Добавить(Строка(СтрокаСубконто.ВидСубконто));
		КонецЦикла;
		Массив.Добавить(Новый Структура("code, name, subconto", Выборка.Код, Выборка.Наименование, Субконто));
	КонецЦикла;
	Возврат Массив;
КонецФункции

#КонецОбласти
